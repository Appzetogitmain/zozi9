{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@core/*": [
                "./src/core/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ],
            "@modules/*": [
                "./src/modules/*"
            ]
        },
        "ignoreDeprecations": "5.0",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
